    }
  ],
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/track",
        "destination": "/track.html"
      },
      {
        "source": "/api/publicTripTracking",
        "function": {
          "functionId": "getPublicTripTracking",
          "region": "asia-southeast1"
        }
      }
    ]
  },
  "emulators": {
