{
  "firestore": {
    "rules":  "firestore.rules"
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "routepool-9405b",
          "appId": "1:428362340196:android:47b3bfaed1a8bdafbb8c71",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "routepool-9405b",
